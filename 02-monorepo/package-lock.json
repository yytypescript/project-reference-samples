{
  "name": "typescript-monorepo-example",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "typescript-monorepo-example",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.9.3"
      }
    },
    "node_modules/@company/cli": {
      "resolved": "packages/cli",
